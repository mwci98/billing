{
  "id": "/qpos",
  "name": "QPOS",
  "short_name": "QPOS",
  "description": "Smart point-of-sale and inventory management.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0A0A0B",
  "theme_color": "#009F5E",
  "categories": ["business", "finance", "productivity"],
  "icons": [
    {
      "src": "/icons/qpos-logo.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-192.png?v=qpos-icon-3",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-512.png?v=qpos-icon-3",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-maskable-512.png?v=qpos-icon-3",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
