{
  "rewrites": [
    {
      "source": "/i/:token",
      "destination": "/api/public-invoice?token=:token"
    },
    {
      "source": "/__/auth/:path*",
      "destination": "https://gen-lang-client-0487602795.firebaseapp.com/__/auth/:path*"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ]
}
